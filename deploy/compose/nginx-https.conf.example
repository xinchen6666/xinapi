# Include in nginx's http context and set the host, certificate and loopback port.
map $http_upgrade $xinapi_connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 443 ssl;
    server_name xinapi.example.com;

    ssl_certificate     /etc/nginx/tls/xinapi/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/xinapi/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 32m;
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $xinapi_connection_upgrade;

        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_next_upstream off;
    }
}
